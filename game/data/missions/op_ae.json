{
  "schema": "meridian.mission/1",
  "id": "op_ae",
  "title": "Operation Second Harvest",
  "group": "operation",
  "order": 7,
  "briefing": [
    {"heading": "Situation", "text": "The Battle of Kasai Ford ended at dawn. Nobody won it: two columns met on the old causeway, burned each other's armour and withdrew behind their own lines. What they left behind is a field of wrecks and a ruined Union Works that was supposed to be the Empire's forward yard. The Steward has ordered it rebuilt before the rains.", "lore": "faction.ae"},
    {"heading": "The Protectorate Claim", "text": "The Protectorate's Claims Board has filed a notice that every wreck on the causeway belongs to the 'ownership of the dead': to whoever buried them. The Empire says whoever pulls a hull out of the mud owns it. Both sides have engineers on the way. The Empire and the Protectorate share an interest in independent reconstruction technology and quarrel over contracts and eastern shipping lanes. Today that quarrel has a causeway.", "lore": "faction.sap"},
    {"heading": "Orders", "text": "Salvage first, then build: your engineers and the Reclaimer can strip a freshly destroyed enemy vehicle for a fifth of its price, but a wreck lasts only a minute, so hold the field while they work. Rebuild a second Refinery, a Factory and a Radar, field fourteen combat units, and hold the Works for fourteen minutes. The Steward will levy a share of your treasury when the accounts are audited; spend it before then."}
  ],
  "map": {"family": "open", "size": 128, "seed": 41, "params": {"biome": 1, "resources": 60}},
  "sim_seed": 7101,
  "rules": {"start_credits": 2200, "fog": 1},
  "players": [
    {"slot": 0, "kind": "human", "name": "Union Works", "roster": "roster.ae.vanilla", "team": 1, "credits": 2200, "start": {"mode": "hq", "units": [{"def": "unit.shared.engineer", "count": 3, "dx": -5, "dy": 0}, {"def": "unit.ae.reclaimer", "count": 1, "dx": -4, "dy": 3}, {"def": "unit.ae.buffalo_tank", "count": 2, "dx": -7, "dy": -3}, {"def": "unit.ae.union_guard", "count": 3, "dx": -6, "dy": 4}, {"def": "unit.ae.pike_team", "count": 2, "dx": -8, "dy": 1}], "structures": [{"def": "structure.shared.generator", "dx": 5, "dy": 3}, {"def": "structure.shared.barracks", "dx": -2, "dy": 8}, {"def": "structure.shared.refinery", "dx": 6, "dy": -3}]}},
    {"slot": 1, "kind": "ai", "name": "Fallen Column", "roster": "roster.ae.vanilla", "team": 1, "start_slot": 1, "ai": {"level": 0, "style": 0, "active": false}, "start": {"mode": "none"}},
    {"slot": 2, "kind": "ai", "name": "Protectorate Claims", "roster": "roster.sap.vanilla", "team": 2, "start_slot": 2, "ai": {"level": 0, "style": 0, "active": false}, "start": {"mode": "hq"}}
  ],
