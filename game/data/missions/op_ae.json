  "messages": [
    {"id": "intro", "text": "Union Works, Steward's Office. The causeway is yours if you can hold it. Dawn is breaking. Salvage the hulls before they sink.", "speaker": "Steward's Office", "announcer": "match_start_ae"},
    {"id": "hint_salvage", "text": "Select an Engineer or the Reclaimer and right-click a wreck to strip it. A wreck pays one fifth of the vehicle's price and lasts about a minute, so work while your tanks cover the field.", "speaker": "Steward's Office"},
    {"id": "hint_build", "text": "A second Refinery, a Factory and a Radar. Salvage pays for the first, the rest should follow from your Collectors.", "speaker": "Steward's Office"},
    {"id": "w1", "text": "Protectorate vanguard on the causeway. They want the wrecks.", "speaker": "Steward's Office", "announcer": "base_under_attack"},
    {"id": "w2", "text": "A second Protectorate group, with howitzers. They are laying the field under fire.", "speaker": "Steward's Office", "announcer": "base_under_attack"},
    {"id": "w3", "text": "Claims force from the west: armour, shield squads and a reclamation column. They intend to take the field by force.", "speaker": "Steward's Office", "announcer": "base_under_attack"},
    {"id": "w4", "text": "Everything the Claims Board has is on the causeway.", "speaker": "Steward's Office", "announcer": "base_under_attack"},
    {"id": "pr_notice", "text": "Notice to the Empire's yard: all salvage on the causeway is held in trust for the next of kin. Cease and desist. A Claims officer will visit to inventory it.", "speaker": "Protectorate Claims Board"},
    {"id": "levy", "text": "AUDIT: the Steward's Office has levied a quarter of the Works' treasury for the capital. You were warned. The yard's workers have noted who signed the order.", "speaker": "Steward's Office", "announcer": "insufficient_funds"},
    {"id": "recovered", "text": "The Fallen Column's command vehicle is back inside the Works. The crew is alive.", "speaker": "Steward's Office"},
    {"id": "convoy", "text": "The Steward's supply convoy is on the road and will reach the Works shortly. Hold on!", "speaker": "Steward's Office", "announcer": "ally_under_attack"},
    {"id": "lose_hq", "text": "The Works' headquarters has fallen. The yard is lost.", "speaker": "Steward's Office", "announcer": "defeat"},
    {"id": "win", "text": "The convoy is through and the Works are running. Fourteen minutes: a yard rebuilt out of the enemy's wrecks.", "speaker": "Steward's Office", "announcer": "victory"},
    {"id": "debrief_win", "text": "DEBRIEF: the Union Works is running again and half its first output was built from Protectorate hulls. The Claims Board will protest at the next corridor conference; the Steward's levy will be a bigger scandal in the yard than the battle was.", "speaker": "Debrief"},
    {"id": "debrief_lose", "text": "DEBRIEF: the Works fell. The Protectorate holds the causeway and the wrecks, and the Steward's Office is looking for someone to explain why the levy was collected.", "speaker": "Debrief"}
  ],
  "objectives": [
    {"id": "rebuild", "kind": "primary", "text": "Rebuild the Works: a second Refinery, a Factory and a Radar"},
    {"id": "army", "kind": "primary", "text": "Field at least 14 combat units"},
    {"id": "hold", "kind": "primary", "text": "Hold the Union Works until the convoy arrives (14:00)"},
    {"id": "engineers", "kind": "secondary", "text": "Keep all three Engineers alive"},
    {"id": "recover", "kind": "secondary", "text": "Tow the Fallen Column's command vehicle into the Works", "initial": "hidden"}
  ],
  "timers": [
    {"id": "conv_t", "seconds": 840, "label": "Supply convoy"}
  ],
