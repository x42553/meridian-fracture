    {"id": "a_n_gate", "shape": "circle", "anchor": "start:0", "x": -4, "y": -36, "r": 5},
    {"id": "a_nw_gate", "shape": "circle", "anchor": "start:0", "x": -30, "y": -30, "r": 5},
    {"id": "a_siege", "shape": "circle", "anchor": "start:0", "x": -14, "y": -33, "r": 5},
    {"id": "a_front", "shape": "circle", "anchor": "start:0", "x": -14, "y": -6, "r": 6}
  ],
  "messages": [
    {"id": "intro", "text": "Varenne, this is Lattice Command. The Relays are live and the exchange is yours. The Directorate columns are forming up beyond the river. Fourteen minutes.", "speaker": "Lattice Command", "announcer": "match_start_nec"},
    {"id": "w1", "text": "Contact on the west road. A raiding party, light armour and infantry.", "speaker": "Lattice Command", "announcer": "base_under_attack"},
    {"id": "w2", "text": "A second party from the north gate. Keep your Relays between them and the exchange.", "speaker": "Lattice Command", "announcer": "base_under_attack"},
    {"id": "w3", "text": "Armour on the west road and infantry through the north-western blocks. They are probing the Relays.", "speaker": "Lattice Command", "announcer": "base_under_attack"},
    {"id": "w4", "text": "Heavy contact from the north-west. This is the main body.", "speaker": "Lattice Command", "announcer": "base_under_attack"},
    {"id": "w5", "text": "Everything the Directorate has is coming through the west and north gates at once.", "speaker": "Lattice Command", "announcer": "base_under_attack"},
    {"id": "or_talks", "text": "Garrison of Varenne: the Directorate offers custody of the exchange under a joint charter. Lay down your arms and nobody needs to be hurt.", "speaker": "Solar Directorate"},
    {"id": "blackout", "text": "Substation failure! Somebody cut the feeders: both generators are down and the lattice is on battery. Rebuild generation before the Relays drop out.", "speaker": "Lattice Command", "announcer": "low_power"},
    {"id": "grid_ok", "text": "Power is back. The Lattice is whole again.", "speaker": "Lattice Command", "announcer": "power_restored"},
    {"id": "siege", "text": "Recon reports Sandglass mortars deploying on the northern ridge. Once they have range they will walk shells across the Relays. Break the siege camp if you can spare the force.", "speaker": "Lattice Command"},
    {"id": "siege_down", "text": "The mortars are silent. The ridge is clear.", "speaker": "Lattice Command"},
    {"id": "relay_lost", "text": "A Relay mast is down. The lattice is thinner now.", "speaker": "Lattice Command", "announcer": "structure_lost"},
    {"id": "relief", "text": "Relief column is on the east road! Hold the exchange for another minute!", "speaker": "Lattice Command", "announcer": "ally_under_attack"},
    {"id": "lose_town", "text": "The Town Hall has fallen. Varenne is lost.", "speaker": "Lattice Command", "announcer": "defeat"},
    {"id": "lose_lattice", "text": "Two Relay masts are gone. Without the lattice the garrison cannot hold the district.", "speaker": "Lattice Command", "announcer": "defeat"},
    {"id": "win", "text": "The relief column is through and the Directorate is falling back across the river. Varenne holds.", "speaker": "Lattice Command", "announcer": "victory"},
    {"id": "debrief_win", "text": "DEBRIEF: the exchange stays under Confederation control, for now. The Order will say the garrison fired first; the Confederation will say the Order brought the columns. The treaty talks reopen next week, and both sides will remember that a single city's power is the real bargaining chip.", "speaker": "Debrief"},
    {"id": "debrief_lose", "text": "DEBRIEF: the exchange fell. The Directorate now holds the wires, and the southern towns have not decided yet whether to be grateful.", "speaker": "Debrief"}
  ],
  "objectives": [
    {"id": "hold", "kind": "primary", "text": "Hold the Town Hall until the relief column arrives (14:00)"},
    {"id": "lattice", "kind": "primary", "text": "Keep at least two Relay masts alive and powered"},
    {"id": "grid", "kind": "primary", "text": "Restore the city's power after the blackout", "initial": "hidden"},
    {"id": "siege", "kind": "secondary", "text": "Destroy the Directorate siege camp on the northern ridge", "initial": "hidden"},
    {"id": "all_relays", "kind": "secondary", "text": "Finish with all three Relay masts standing"}
  ],
  "timers": [
    {"id": "relief_t", "seconds": 840, "label": "Relief column"}
  ],
