  ],
  "messages": [
    {"id": "intro", "text": "Well Guard, this is Well Command. All three pumps are running. The Authority's raiders are massing behind the dunes. Thirteen minutes, two pumps.", "speaker": "Well Command", "announcer": "match_start_olm"},
    {"id": "r1", "text": "Raiders on the west dunes heading for the far pump.", "speaker": "Well Command", "announcer": "base_under_attack"},
    {"id": "r2", "text": "A second party is coming up from the south dunes toward the southern pump.", "speaker": "Well Command", "announcer": "base_under_attack"},
    {"id": "hint_mob", "text": "Remember what we are: do not sit on the pumps. Strike where they gather and fall back before the second party arrives. A Mirage Observer that stands still for six seconds disappears; the Dust Screen hides a whole formation.", "speaker": "Well Command"},
    {"id": "depot", "text": "Scouts report the Authority has raised a forward depot in the western dunes, with a crane, a repair bay and guns. Every raid since this morning has been resupplied from there. Take it down and the raids end.", "speaker": "Well Command", "announcer": "enemy_sw_charging"},
    {"id": "au_talks", "text": "Well Guard: the Authority proposes joint custody of the pumps under a treaty. Withdraw your defenders and we will guarantee the water.", "speaker": "Corridor Authority"},
    {"id": "depot_down", "text": "The forward depot is burning. No more raids will leave it.", "speaker": "Well Command"},
    {"id": "pump_lost", "text": "A pump is down. The enclaves will notice within the hour.", "speaker": "Well Command", "announcer": "structure_lost"},
    {"id": "last_push", "text": "Everything the Authority has left is coming for the pumps. Hold on.", "speaker": "Well Command", "announcer": "base_under_attack"},
    {"id": "lose_pumps", "text": "Two of the three pumps are lost. The enclaves have no water.", "speaker": "Well Command", "announcer": "defeat"},
    {"id": "lose_base", "text": "The Well Guard headquarters has fallen.", "speaker": "Well Command", "announcer": "defeat"},
    {"id": "win", "text": "Thirteen minutes. The pumps are running and the depot is gone. The enclaves keep their water.", "speaker": "Well Command", "announcer": "victory"},
    {"id": "debrief_win", "text": "DEBRIEF: the Order kept its wells and the Empire kept its corridor. The Authority's stewards will tell their council they were testing the Oath; the Order's solar directorate will use the episode to ask for exclusive custody of the pump controls. Everyone in the basin can see where that leads.", "speaker": "Debrief"},
    {"id": "debrief_lose", "text": "DEBRIEF: the pumps changed hands. The Authority promises a fair tariff. The enclaves have heard that before.", "speaker": "Debrief"}
  ],
  "objectives": [
    {"id": "pumps", "kind": "primary", "text": "Keep at least two of the three well pumps running for 13:00"},
    {"id": "depot", "kind": "primary", "text": "Destroy the Authority's forward depot", "initial": "hidden"},
    {"id": "hq", "kind": "primary", "text": "Do not lose the headquarters"},
    {"id": "all_pumps", "kind": "secondary", "text": "Finish with all three pumps running"},
    {"id": "observer", "kind": "secondary", "text": "Keep your Mirage Observer alive"}
  ],
  "timers": [
    {"id": "hold_t", "seconds": 780, "label": "Pumps must run"}
  ],
