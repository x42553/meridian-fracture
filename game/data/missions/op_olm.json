    {"id": "t90_win", "when": {"all": [{"kind": "timer", "timer": "hold_t"}, {"kind": "objective", "objective": "depot", "state": "completed"}, {"any": [{"all": [{"not": {"kind": "structure", "state": "destroyed", "placed": "well_a"}}, {"not": {"kind": "structure", "state": "destroyed", "placed": "well_b"}}]}, {"all": [{"not": {"kind": "structure", "state": "destroyed", "placed": "well_a"}}, {"not": {"kind": "structure", "state": "destroyed", "placed": "well_c"}}]}, {"all": [{"not": {"kind": "structure", "state": "destroyed", "placed": "well_b"}}, {"not": {"kind": "structure", "state": "destroyed", "placed": "well_c"}}]}]}, {"kind": "count", "owner": 0, "def": "structure.shared.headquarters", "value": 1}]}, "then": [{"do": "set_objective", "objective": "pumps", "state": "completed"}, {"do": "set_objective", "objective": "hq", "state": "completed"}, {"do": "show_message", "message": "win"}, {"do": "show_message", "message": "debrief_win"}, {"do": "win", "owner": 0}, {"do": "music_state", "state": "victory"}]},
