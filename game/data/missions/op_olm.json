{
  "schema": "meridian.mission/1",
  "id": "op_olm",
  "title": "Operation Deep Wells",
  "group": "operation",
  "order": 3,
  "briefing": [
    {"heading": "Situation", "text": "Three deep desalination wells feed the coastal enclaves of the eastern basin, and their pumps run on the Order's own solar fields. The wells are the reason the enclaves signed the Oath. They are also the reason the Corridor Authority, which taxes every cargo moving along the coast road, would like them to belong to someone else.", "lore": "faction.olm"},
    {"heading": "The Corridor Authority", "text": "The African Empire's corridor stewards say they want a treaty on water. They also want the pumps' control software, and a raiding force with salvage crews is gathering to take both. Trade between the Order and the Empire is the only thing keeping the coast alive, which is why nobody on either side wants to be the one who says this is a war.", "lore": "faction.ae"},
    {"heading": "Orders", "text": "Keep at least two of the three well pumps running for thirteen minutes. You cannot cover all three with walls, so do not try: keep your armour mobile, hide it with Mirage Observers and the Dust Screen, and strike the raiders where they gather. When the Authority's forward depot appears, destroy it: it is where every later wave comes from."}
  ],
  "map": {"family": "open", "size": 128, "seed": 21, "params": {"biome": 1}},
  "sim_seed": 3101,
  "rules": {"start_credits": 5000, "fog": 1},
  "players": [
    {"slot": 0, "kind": "human", "name": "Well Guard", "roster": "roster.olm.vanilla", "team": 1, "credits": 5000, "start": {"mode": "hq", "units": [{"def": "unit.olm.sirocco_tank", "count": 3, "dx": -5, "dy": -3}, {"def": "unit.olm.wayfarer_guard", "count": 2, "dx": -4, "dy": 4}, {"def": "unit.olm.needle_team", "count": 2, "dx": -7, "dy": 1}, {"def": "unit.olm.crescent_aa", "count": 1, "dx": -2, "dy": 6}, {"def": "unit.olm.mirage_observer", "count": 1, "dx": -6, "dy": -6}], "structures": [{"def": "structure.shared.generator", "dx": 5, "dy": 4}, {"def": "structure.shared.refinery", "dx": 5, "dy": -2}, {"def": "structure.shared.barracks", "dx": -3, "dy": 8}, {"def": "structure.shared.generator", "dx": -13, "dy": -10, "id": "well_a"}, {"def": "structure.shared.generator", "dx": -8, "dy": 15, "id": "well_b"}, {"def": "structure.shared.generator", "dx": -27, "dy": -3, "id": "well_c"}, {"def": "structure.shared.watchtower", "dx": -13, "dy": -8}, {"def": "structure.shared.watchtower", "dx": -8, "dy": 13}]}},
    {"slot": 1, "kind": "ai", "name": "Corridor Authority", "roster": "roster.ae.vanilla", "team": 2, "start_slot": 2, "ai": {"level": 1, "style": 0, "active": false}, "start": {"mode": "hq"}}
  ],
