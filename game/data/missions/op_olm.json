    {"id": "t32_resupply_c", "once": false, "enabled": false, "cooldown_s": 200, "when": {"kind": "time", "cmp": ">=", "seconds": 640}, "then": [{"do": "spawn_units", "owner": 1, "def": "unit.ae.buffalo_tank", "count": 2, "area": "a_dunes_n", "wave": "res_c", "order": {"kind": "attack_move", "area": "a_well_a"}}, {"do": "spawn_units", "owner": 1, "def": "unit.ae.pike_team", "count": 2, "area": "a_dunes_n", "wave": "res_c", "order": {"kind": "attack_move", "area": "a_well_a"}}]},
    {"id": "t33_depot_down", "when": {"all": [{"kind": "objective", "objective": "depot", "state": "active"}, {"kind": "structure", "state": "destroyed", "placed": "dep1"}, {"kind": "structure", "state": "destroyed", "placed": "dep2"}, {"kind": "structure", "state": "destroyed", "placed": "dep4"}]}, "then": [{"do": "set_objective", "objective": "depot", "state": "completed"}, {"do": "show_message", "message": "depot_down"}, {"do": "trigger_disable", "trigger": "t30_resupply_a"}, {"do": "trigger_disable", "trigger": "t31_resupply_b"}, {"do": "trigger_disable", "trigger": "t32_resupply_c"}, {"do": "trigger_disable", "trigger": "t21_reveal"}]},
