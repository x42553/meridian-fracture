  "messages": [
    {"id": "intro", "text": "Staging Camp, this is the Supply Ministry. The timetable begins at Junction One. Guns first. Move at your own discretion, but move.", "speaker": "Supply Ministry", "announcer": "match_start_def"},
    {"id": "j1_down", "text": "Junction One is ours. The Ministry notes the timetable has changed. On to Junction Two.", "speaker": "Supply Ministry", "announcer": "building_captured"},
    {"id": "j2_down", "text": "Junction Two has fallen. Two of three. The Han depot commands are no longer answering the Ministry's signals.", "speaker": "Supply Ministry", "announcer": "building_captured"},
    {"id": "j3_down", "text": "Junction Three is down. The northern belt is under Federation schedule.", "speaker": "Supply Ministry", "announcer": "building_captured"},
    {"id": "twist", "text": "Staging Camp: the Han depot command is not waiting. A drone swarm is coming out of the western belt for your camp. Your guns are forward. Decide who defends the camp.", "speaker": "Supply Ministry", "announcer": "base_under_attack"},
    {"id": "han_voice", "text": "Federation column, you are in breach of the Border Depot Charter. Withdraw and the timetable is yours by treaty in the spring.", "speaker": "Border Depot Command"},
    {"id": "grain_lost", "text": "The grain depot is gone. The district's delegates are already leaving the assembly.", "speaker": "Supply Ministry", "announcer": "structure_lost"},
    {"id": "late", "text": "The Ministry's patience is not unlimited. Two minutes remain in the window.", "speaker": "Supply Ministry"},
    {"id": "lose_camp", "text": "The Staging Camp is lost. The push is over.", "speaker": "Supply Ministry", "announcer": "defeat"},
    {"id": "lose_time", "text": "The window has closed. The Ministry is recalling the column.", "speaker": "Supply Ministry", "announcer": "defeat"},
    {"id": "win", "text": "All three junctions are in Federation hands. The timetable is written.", "speaker": "Supply Ministry", "announcer": "victory"},
    {"id": "debrief_win", "text": "DEBRIEF: the Federation now schedules the northern belt. The Ministry calls this industrial recovery. The Han depot commands call it occupation, and the district behind the grain depot calls it neither, because nobody asked it. In the capitals both sides are already negotiating who owns the timetable the rail will actually run on.", "speaker": "Debrief"},
    {"id": "debrief_lose", "text": "DEBRIEF: the push stalled. The junctions stay under Han schedule; the Ministry will ask the districts for more quotas, and the districts will answer.", "speaker": "Debrief"}
  ],
  "objectives": [
    {"id": "j1", "kind": "primary", "text": "Destroy the control post at Junction One"},
    {"id": "j2", "kind": "primary", "text": "Destroy the control post at Junction Two", "initial": "hidden"},
    {"id": "j3", "kind": "primary", "text": "Destroy the control post at Junction Three", "initial": "hidden"},
    {"id": "grain", "kind": "secondary", "text": "Do not destroy the grain depot beside Junction Two", "initial": "hidden"},
    {"id": "guns", "kind": "secondary", "text": "Finish with at least two Anvil batteries"}
  ],
