{
  "schema": "meridian.mission/1",
  "id": "tut_field_training",
  "title": "Field Training",
  "group": "tutorial",
  "order": 0,
  "briefing": [
    {"heading": "Welcome to the Academy", "text": "The North American Peace Corps trains every new commander at the Reconstruction Academy before sending them to a corridor. This course takes about fifteen minutes and walks you through the whole game: camera, orders, economy, production, defence, support powers and the one thing every commander eventually meets, a superweapon warning.", "lore": "faction.napc"},
    {"heading": "How it works", "text": "Each step appears in the objectives list with a short hint. Steps complete when you do the thing. If you get stuck the Instructor helps after a while (funds, a building or a squad), so you cannot lock yourself out. Nothing here is scored."},
    {"heading": "Controls", "text": "Every key can be changed in Options, Controls. The hints name the defaults. Press F1 at any time for the Field Manual."}
  ],
  "map": {"family": "open", "size": 128, "seed": 10},
  "sim_seed": 10,
  "rules": {"start_credits": 4500, "fog": 0, "superweapons": 1},
  "players": [
    {"slot": 0, "kind": "human", "name": "Cadet", "roster": "roster.napc.vanilla", "team": 1, "start": {"mode": "hq", "units": [{"def": "unit.napc.guardian_tank", "count": 3, "dx": 4, "dy": 3}]}},
    {"slot": 1, "kind": "ai", "name": "Instructor Force", "roster": "roster.nec.vanilla", "team": 2, "start_slot": 1, "credits": 0, "ai": {"level": 0, "style": 0, "active": false}, "start": {"mode": "none"}},
    {"slot": 2, "kind": "ai", "name": "Rival Array", "roster": "roster.nec.vanilla", "team": 2, "start_slot": 2, "credits": 0, "ai": {"level": 2, "style": 0, "active": false}, "start": {"mode": "none"}}
  ],
