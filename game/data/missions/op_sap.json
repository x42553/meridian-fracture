    {"id": "t10_lb_in", "when": {"all": [{"kind": "objective", "objective": "lb", "state": "active"}, {"kind": "count", "owner": 0, "tag": "combat", "area": "a_lb", "value": 6}, {"kind": "time", "cmp": ">=", "seconds": 340}]}, "then": [{"do": "set_objective", "objective": "guns", "state": "active"}, {"do": "show_message", "message": "lb_in"}, {"do": "show_message", "message": "guns"}, {"do": "spawn_units", "owner": 1, "def": "unit.pd.breaker_howitzer", "count": 3, "area": "a_ridge_w", "wave": "guns_w", "order": {"kind": "hold"}}, {"do": "spawn_units", "owner": 1, "def": "unit.pd.storm_aa", "count": 1, "area": "a_ridge_w", "wave": "guns_w", "order": {"kind": "guard", "area": "a_ridge_w"}}, {"do": "spawn_units", "owner": 1, "def": "unit.pd.breaker_howitzer", "count": 2, "area": "a_ridge_e", "wave": "guns_e", "order": {"kind": "hold"}}, {"do": "spawn_units", "owner": 1, "def": "unit.pd.ranger_marine", "count": 2, "area": "a_ridge_e", "wave": "guns_e", "order": {"kind": "guard", "area": "a_ridge_e"}}, {"do": "timer_start", "timer": "hold_b"}, {"do": "music_state", "state": "combat"}]},
    {"id": "t11_lb_done", "when": {"all": [{"kind": "objective", "objective": "lb", "state": "active"}, {"kind": "timer", "timer": "hold_b"}, {"kind": "count", "owner": 0, "tag": "combat", "area": "a_lb", "value": 6}, {"kind": "wave", "wave": "guns_w", "state": "cleared"}, {"kind": "wave", "wave": "guns_e", "state": "cleared"}]}, "then": [{"do": "set_objective", "objective": "lb", "state": "completed"}, {"do": "set_objective", "objective": "guns", "state": "completed"}, {"do": "show_message", "message": "lb_done"}, {"do": "show_message", "message": "guns_out"}, {"do": "music_state", "state": "tense"}]},
