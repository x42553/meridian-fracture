    {"id": "t90_win", "when": {"all": [{"kind": "objective", "objective": "lb", "state": "completed"}, {"kind": "objective", "objective": "lc", "state": "completed"}, {"kind": "objective", "objective": "post", "state": "completed"}]}, "then": [{"do": "set_objective", "objective": "base", "state": "completed"}, {"do": "show_message", "message": "win"}, {"do": "show_message", "message": "debrief_win"}, {"do": "win", "owner": 0}, {"do": "music_state", "state": "victory"}]},
