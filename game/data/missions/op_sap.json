  "messages": [
    {"id": "intro", "text": "Strait Column, Protectorate Council. The road is open as far as Line Bravo. Advance in order, under the Trident, and do not outrun your own guns.", "speaker": "Protectorate Council", "announcer": "match_start_sap"},
    {"id": "hint_trident", "text": "The Trident Array in your base takes about six minutes to charge. Aim it at the army when the Dominion guns open: for twenty-five seconds every shell that crosses the ring is destroyed.", "speaker": "Protectorate Council", "announcer": "sw_charging"},
    {"id": "lb_in", "text": "Line Bravo reached. Hold it until the guns have found you, then we move.", "speaker": "Protectorate Council"},
    {"id": "lb_done", "text": "Line Bravo is quiet. On to Line Charlie.", "speaker": "Protectorate Council", "announcer": "building_captured"},
    {"id": "guns", "text": "Dominion howitzers have opened from the ridges! Interception now, or take cover!", "speaker": "Protectorate Council", "announcer": "base_under_attack"},
    {"id": "guns_out", "text": "The ridge guns are silent. Line Bravo is quiet.", "speaker": "Protectorate Council"},
    {"id": "lc_in", "text": "Line Charlie reached. The customs post is in sight.", "speaker": "Protectorate Council"},
    {"id": "lc_done", "text": "Line Charlie is held. The Inspection Hall is the last objective.", "speaker": "Protectorate Council", "announcer": "building_captured"},
    {"id": "landing", "text": "Dominion marines are coming ashore behind the column! Your base is the next target. Turn and defend the road!", "speaker": "Protectorate Council", "announcer": "base_under_attack"},
    {"id": "pd_voice", "text": "Protectorate column: the customs post is neutral ground. Turn back and the Fleet will guarantee safe passage by sea.", "speaker": "Inspection Fleet"},
    {"id": "tower_lost", "text": "The interception array is down. The guns will find the column.", "speaker": "Protectorate Council", "announcer": "structure_lost"},
    {"id": "lose_hq", "text": "The base has fallen behind the column. There is no road to hold.", "speaker": "Protectorate Council", "announcer": "defeat"},
    {"id": "lose_time", "text": "The evacuation window has closed. The Council recalls the column.", "speaker": "Protectorate Council", "announcer": "defeat"},
    {"id": "win", "text": "The Inspection Hall is rubble and the road is open. The evacuees are moving.", "speaker": "Protectorate Council", "announcer": "victory"},
    {"id": "debrief_win", "text": "DEBRIEF: the strait road is open and the first evacuation convoy moved within the hour. The Dominion calls the action a breach of the customs charter; the Council calls it a rescue. Reformers in the Council point out that the Protectorate's guards were not asked to leave when the emergency ended either, and that this is what both sides have in common.", "speaker": "Debrief"},
    {"id": "debrief_lose", "text": "DEBRIEF: the advance failed. The post stays, the guns stay, and the evacuees stay on the wrong side of both.", "speaker": "Debrief"}
  ],
  "objectives": [
    {"id": "advance", "kind": "primary", "text": "Advance in order: Line Bravo (silence the ridge guns, hold), then Line Charlie (hold)"},
    {"id": "lb", "kind": "hidden", "text": "Line Bravo"},
    {"id": "lc", "kind": "hidden", "text": "Line Charlie", "initial": "hidden"},
    {"id": "post", "kind": "primary", "text": "Destroy the Inspection Hall at the customs post", "initial": "hidden"},
    {"id": "base", "kind": "primary", "text": "Do not lose the base"},
    {"id": "guns", "kind": "hidden", "text": "Dominion guns firing on Line Bravo", "initial": "hidden"},
    {"id": "trident", "kind": "secondary", "text": "Keep the Trident Interception Array alive"},
    {"id": "layers", "kind": "secondary", "text": "Layer the base: build at least four defensive structures"}
  ],
  "timers": [
    {"id": "hold_b", "seconds": 120, "label": "Hold Line Bravo"},
    {"id": "hold_c", "seconds": 90, "label": "Hold Line Charlie"}
  ],
