    {"id": "t20_tower", "when": {"all": [{"kind": "objective", "objective": "trident", "state": "active"}, {"kind": "structure", "state": "destroyed", "placed": "trident"}]}, "then": [{"do": "set_objective", "objective": "trident", "state": "failed"}, {"do": "show_message", "message": "tower_lost"}]},
