  "messages": [
    {"id": "intro", "text": "Mesh Column, Imperial Court. The monsoon is three weeks out. Walk the operators to the first node and raise the mast.", "speaker": "Imperial Court", "announcer": "match_start_han"},
    {"id": "n1_up", "text": "Node One: mast raised on the first attempt. The Nest group reports a clean picture all the way to the ridge.", "speaker": "Imperial Court"},
    {"id": "n2_up", "text": "Node Two is up. Two of three. The mesh now covers the whole western belt.", "speaker": "Imperial Court"},
    {"id": "n3_up", "text": "Node Three is live. The mesh is complete from the capital to the border.", "speaker": "Imperial Court", "announcer": "victory"},
    {"id": "next2", "text": "The Court has cleared the next segment of the belt: the second node is at the marked site in the northwest. Walk the operators there when the column is ready.", "speaker": "Imperial Court"},
    {"id": "next3", "text": "The last node is at the Canopy depot ridge. Whatever is left of the Canopy raiders will be waiting.", "speaker": "Imperial Court"},
    {"id": "arrive", "text": "The mast is going up. Canopy scouts have seen it. Raiders inbound!", "speaker": "Imperial Court", "announcer": "base_under_attack"},
    {"id": "order", "text": "Mesh Column: by Central Priority the Court orders the Canopy depot beside Node Three destroyed. The partner has refused the schedule and its stores will be redistributed. Acknowledge.", "speaker": "Imperial Court"},
    {"id": "order_done", "text": "The depot is gone. The Court thanks the Column. The Canopy Command has already stopped answering the Court's signals.", "speaker": "Imperial Court"},
    {"id": "spare_ok", "text": "The depot still stands. The Court will note that the Column did not acknowledge Central Priority.", "speaker": "Imperial Court"},
    {"id": "vn_voice", "text": "Imperial column: that depot feeds three villages. We will not shoot at the operators while they walk past it. We will shoot at anything that fires on it.", "speaker": "Canopy Command"},
    {"id": "op_lost", "text": "An operator is down. The mesh thins.", "speaker": "Imperial Court", "announcer": "unit_lost"},
    {"id": "lose_ops", "text": "Fewer than two operators remain. The mesh cannot be raised.", "speaker": "Imperial Court", "announcer": "defeat"},
    {"id": "lose_post", "text": "The Mesh Column headquarters is lost.", "speaker": "Imperial Court", "announcer": "defeat"},
    {"id": "lose_time", "text": "The monsoon has closed the roads. The mesh stays dark.", "speaker": "Imperial Court", "announcer": "defeat"},
    {"id": "win", "text": "All three nodes are live. The Canopy Belt is on the plan.", "speaker": "Imperial Court", "announcer": "victory"},
    {"id": "debrief_win_order", "text": "DEBRIEF: the mesh is up and the Canopy depot is rubble. The Court calls it Central Priority. The Canopy Command has stopped sending liaison officers, and two provincial governors have asked to hear exactly who wrote the plan before they hear what it says.", "speaker": "Debrief"},
    {"id": "debrief_win_spare", "text": "DEBRIEF: the mesh is up and the Canopy depot still stands. The Court's auditors will write that the Column failed to follow Central Priority. The Canopy Command will write that the Court's own soldiers kept its word. Both reports will be filed in the same office.", "speaker": "Debrief"},
    {"id": "debrief_lose", "text": "DEBRIEF: the mesh stays dark. Each side will say the other's depots were the problem; the drones stay in their racks.", "speaker": "Debrief"}
  ],
  "objectives": [
    {"id": "nodes", "kind": "primary", "text": "Raise the three relay nodes: an operator at each marked site while its raiders are repelled"},
