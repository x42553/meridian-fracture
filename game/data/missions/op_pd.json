  "messages": [
    {"id": "intro", "text": "Landing Group, this is the fleet. The bay is calm and the harbour is in sight. Clear the quays and hold them. Seven minutes would make the right point.", "speaker": "Landing Group", "announcer": "match_start_pd"},
    {"id": "seized", "text": "The quays are ours. The shipping council is signalling from the harbour office. Hold the port for seven minutes: the Empire will not leave it at that.", "speaker": "Landing Group", "announcer": "building_captured"},
    {"id": "counter1", "text": "Han counter-attack from the north road: drone nests and armour. The port is the prize, not the road.", "speaker": "Landing Group", "announcer": "base_under_attack"},
    {"id": "counter2", "text": "Second counter-attack from the west road and a jade carrier on the bay.", "speaker": "Landing Group", "announcer": "base_under_attack"},
    {"id": "counter3", "text": "They are throwing everything at the quays. Seven minutes, Landing Group.", "speaker": "Landing Group", "announcer": "base_under_attack"},
    {"id": "counter4", "text": "Last wave: everything the harbour command has left, from the north road, the west road and the bay.", "speaker": "Landing Group", "announcer": "base_under_attack"},
    {"id": "han_voice", "text": "Dominion units: you are in violation of the Treaty Port Charter. Withdraw and the council will be reconvened under neutral chairmanship.", "speaker": "Harbour Command"},
    {"id": "office_lost", "text": "The harbour office has been hit. The shipping council has lost its meeting hall, and they will remember who fired.", "speaker": "Landing Group", "announcer": "structure_lost"},
    {"id": "fast", "text": "The port fell inside seven minutes. The fleet will remember it.", "speaker": "Landing Group"},
    {"id": "slow", "text": "Seven minutes are gone. The right people will have made up their minds already.", "speaker": "Landing Group"},
    {"id": "lose_hq", "text": "The beachhead is overrun. The Landing Group is withdrawing under fire.", "speaker": "Landing Group", "announcer": "defeat"},
    {"id": "lose_port", "text": "The port has been retaken. The Landing Group has no foothold left.", "speaker": "Landing Group", "announcer": "defeat"},
    {"id": "lose_time", "text": "The window for the landing has closed. The fleet is recalled.", "speaker": "Landing Group", "announcer": "defeat"},
    {"id": "win", "text": "Seven minutes. The port is quiet and the council is in session. The treaty port is open to every flag again.", "speaker": "Landing Group", "announcer": "victory"},
    {"id": "debrief_win", "text": "DEBRIEF: the Landing Group holds the quays and the shipping council meets under Dominion escort. The Empire protests that the charter forbids foreign garrisons, and the Dominion answers that its own garrison is eleven days shorter than the Empire's. Residents on the quayside are not sure which of them they trust less.", "speaker": "Debrief"},
    {"id": "debrief_lose", "text": "DEBRIEF: the landing failed. The Empire's garrison is now permanent, and so is the shipping council's silence.", "speaker": "Debrief"}
  ],
  "objectives": [
    {"id": "seize", "kind": "primary", "text": "Land, clear the Port of Marais and take the quays"},
    {"id": "hold", "kind": "primary", "text": "Hold the port for 7:00 against the counter-attack", "initial": "hidden"},
    {"id": "hq", "kind": "primary", "text": "Keep your beachhead headquarters standing"},
    {"id": "office", "kind": "secondary", "text": "Spare the harbour office"},
    {"id": "swift", "kind": "secondary", "text": "Take the port within 7:00"}
  ],
  "timers": [
