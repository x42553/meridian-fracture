{
  "schema": "meridian.mission/1",
  "id": "demo_ambush",
  "title": "Demo: Ambush at the Ridge",
  "group": "demo",
  "order": 1,
  "briefing": [
    {"heading": "Situation", "text": "A small NEC raiding party has been spotted massing behind the eastern ridge. They will strike your base in about a minute.", "lore": "faction.nec"},
    {"heading": "Orders", "text": "Hold your headquarters and destroy the raiders. Do not lose the base."}
  ],
  "map": {"family": "open", "size": 96, "seed": 7},
  "rules": {"start_credits": 5000, "fog": false},
  "players": [
    {"slot": 0, "kind": "human", "name": "Commander", "roster": "roster.napc.vanilla", "team": 1,
     "start": {"mode": "hq", "units": [{"def": "unit.napc.guardian_tank", "count": 3, "dx": 4, "dy": 3}, {"def": "unit.napc.rifle_squad", "count": 2, "dx": 3, "dy": 5}]}},
    {"slot": 1, "kind": "ai", "name": "Raiders", "roster": "roster.nec.vanilla", "team": 2, "start_slot": 1,
     "ai": {"level": 1, "style": 0, "active": false}, "start": {"mode": "none"}}
  ],
  "areas": [
    {"id": "base", "shape": "circle", "anchor": "start:0", "x": 0, "y": 0, "r": 9},
    {"id": "ridge", "shape": "circle", "anchor": "start:1", "x": 0, "y": 0, "r": 6},
    {"id": "centre", "shape": "rect", "anchor": "map", "x": 450, "y": 450, "w": 10, "h": 10}
  ],
  "messages": [
    {"id": "intro", "text": "Raiders will arrive in 60 seconds. Dig in.", "speaker": "Command"},
    {"id": "wave_go", "text": "Contact! Raiders are attacking from the east.", "speaker": "Command", "announcer": "base_under_attack"},
    {"id": "won", "text": "The raiders are destroyed. Well done.", "speaker": "Command"}
  ],
  "objectives": [
    {"id": "destroy_raiders", "kind": "primary", "text": "Destroy the raiding party"},
    {"id": "keep_hq", "kind": "primary", "text": "Keep your headquarters alive"},
    {"id": "scout_centre", "kind": "secondary", "text": "Send a unit to the centre of the map"}
  ],
  "timers": [
    {"id": "raid", "seconds": 60, "label": "Raid"}
  ],
  "triggers": [
    {"id": "a_start", "when": {"kind": "time", "ticks": 0},
     "then": [{"do": "show_message", "message": "intro"}, {"do": "timer_start", "timer": "raid"}, {"do": "music_state", "state": "calm"}]},
    {"id": "b_raid", "when": {"kind": "timer", "timer": "raid"},
     "then": [
       {"do": "spawn_units", "owner": 1, "def": "unit.nec.leopard_tank", "count": 3, "area": "ridge", "wave": "raiders", "order": {"kind": "attack_move", "area": "base"}},
       {"do": "spawn_units", "owner": 1, "def": "unit.nec.jager_squad", "count": 2, "area": "ridge", "wave": "raiders", "order": {"kind": "attack_move", "area": "base"}},
       {"do": "show_message", "message": "wave_go"}, {"do": "music_state", "state": "combat"}, {"do": "camera_hint", "area": "ridge", "seconds": 4}]},
    {"id": "c_scout", "when": {"kind": "count", "owner": 0, "of": "unit", "area": "centre", "value": 1},
     "then": [{"do": "set_objective", "objective": "scout_centre", "state": "completed"}]},
    {"id": "d_clear", "when": {"kind": "wave", "wave": "raiders", "state": "cleared"},
     "then": [{"do": "set_objective", "objective": "destroy_raiders", "state": "completed"}, {"do": "show_message", "message": "won"}, {"do": "win", "owner": 0}]},
    {"id": "e_lose", "when": {"kind": "count", "owner": 0, "of": "structure", "cmp": "<=", "value": 0},
     "then": [{"do": "set_objective", "objective": "keep_hq", "state": "failed"}, {"do": "lose", "owner": 0}]}
  ]
}
