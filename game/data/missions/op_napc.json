    {"id": "t1c3a_loss", "enabled": false, "when": {"all": [{"kind": "objective", "objective": "intact", "state": "active"}, {"kind": "objective", "objective": "live_c", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "cmp": "<", "value": 4}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "area": "a_exit", "value": 3}]}, "then": [{"do": "set_objective", "objective": "intact", "state": "failed"}]},
    {"id": "t1c3b_arrive", "when": {"all": [{"kind": "objective", "objective": "live_c", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "area": "a_exit", "value": 3}]}, "then": [{"do": "set_objective", "objective": "live_c", "state": "completed"}, {"do": "set_objective", "objective": "done_c", "state": "completed"}, {"do": "show_message", "message": "arr_c"}, {"do": "destroy", "owner": 1, "def": "unit.napc.pathfinder_apc"}, {"do": "music_state", "state": "calm"}, {"do": "timer_stop", "timer": "hop_t"}]},
    {"id": "t1c4_fail", "enabled": false, "when": {"all": [{"kind": "objective", "objective": "live_c", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "cmp": "<", "value": 3}]}, "then": [{"do": "show_message", "message": "lose_col"}, {"do": "show_message", "message": "debrief_lose"}, {"do": "set_objective", "objective": "evac", "state": "failed"}, {"do": "lose", "owner": 0}, {"do": "music_state", "state": "defeat"}]},
    {"id": "t20_twist", "when": {"all": [{"kind": "objective", "objective": "done_a", "state": "completed"}]}, "then": [{"do": "show_message", "message": "twist"}, {"do": "show_message", "message": "ov_warn"}, {"do": "set_objective", "objective": "checkpoint", "state": "active"}, {"do": "spawn_structure", "owner": 2, "def": "structure.shared.anti_tank_turret", "area": "a_chk", "id": "chk1"}, {"do": "spawn_structure", "owner": 2, "def": "structure.shared.anti_tank_turret", "area": "a_chk", "id": "chk2"}, {"do": "spawn_structure", "owner": 2, "def": "structure.shared.watchtower", "area": "a_chk", "id": "chk3"}, {"do": "spawn_units", "owner": 2, "def": "unit.nec.leopard_tank", "count": 3, "area": "a_chk", "wave": "chk_guard", "order": {"kind": "guard", "area": "a_chk"}}, {"do": "spawn_units", "owner": 2, "def": "unit.nec.spike_team", "count": 2, "area": "a_chk", "wave": "chk_guard", "order": {"kind": "guard", "area": "a_chk"}}, {"do": "reveal_area", "owner": 1, "area": "a_chk", "seconds": 20}, {"do": "camera_hint", "area": "a_chk", "seconds": 6}, {"do": "trigger_enable", "trigger": "t21_reveal"}]},
    {"id": "t21_reveal", "once": false, "enabled": false, "cooldown_s": 40, "when": {"all": [{"kind": "objective", "objective": "checkpoint", "state": "active"}]}, "then": [{"do": "reveal_area", "owner": 0, "area": "a_chk", "seconds": 8}]},
    {"id": "t22_chk_down", "when": {"all": [{"kind": "objective", "objective": "checkpoint", "state": "active"}, {"kind": "structure", "state": "destroyed", "placed": "chk1"}, {"kind": "structure", "state": "destroyed", "placed": "chk2"}, {"kind": "structure", "state": "destroyed", "placed": "chk3"}]}, "then": [{"do": "set_objective", "objective": "checkpoint", "state": "completed"}, {"do": "show_message", "message": "chk_down"}, {"do": "trigger_disable", "trigger": "t21_reveal"}]},
    {"id": "t80_late", "when": {"kind": "time", "cmp": ">=", "seconds": 1050}, "then": [{"do": "show_message", "message": "late"}]},
    {"id": "t90_win", "when": {"all": [{"kind": "objective", "objective": "done_a", "state": "completed"}, {"kind": "objective", "objective": "done_b", "state": "completed"}, {"kind": "objective", "objective": "done_c", "state": "completed"}]}, "then": [{"do": "set_objective", "objective": "evac", "state": "completed"}, {"do": "show_message", "message": "win"}, {"do": "show_message", "message": "debrief_win"}, {"do": "win", "owner": 0}, {"do": "music_state", "state": "victory"}]},
    {"id": "t91_lose_post", "when": {"kind": "count", "owner": 0, "def": "structure.shared.headquarters", "cmp": "<=", "value": 0}, "then": [{"do": "set_objective", "objective": "post", "state": "failed"}, {"do": "show_message", "message": "lose_post"}, {"do": "show_message", "message": "debrief_lose"}, {"do": "lose", "owner": 0}, {"do": "music_state", "state": "defeat"}]},
    {"id": "t92_lose_time", "when": {"kind": "time", "cmp": ">=", "seconds": 1200}, "then": [{"do": "set_objective", "objective": "evac", "state": "failed"}, {"do": "show_message", "message": "lose_time"}, {"do": "show_message", "message": "debrief_lose"}, {"do": "lose", "owner": 0}, {"do": "music_state", "state": "defeat"}]}
  ]
}
