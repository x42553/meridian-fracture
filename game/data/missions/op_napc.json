    {"id": "t1c1_hop1", "enabled": false, "when": {"kind": "timer", "timer": "hop_t"}, "then": [{"do": "order_units", "owner": 1, "order": {"kind": "move", "area": "a_wp2"}}, {"do": "show_message", "message": "hop"}, {"do": "timer_start", "timer": "hop_t"}, {"do": "trigger_enable", "trigger": "t1c2_hop2"}, {"do": "trigger_enable", "trigger": "t1c3a_loss"}, {"do": "trigger_enable", "trigger": "t1c4_fail"}]},
