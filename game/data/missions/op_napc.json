{
  "schema": "meridian.mission/1",
  "id": "op_napc",
  "title": "Operation Open Road",
  "group": "operation",
  "order": 1,
  "briefing": [
    {"heading": "Situation", "text": "Two weeks after a grid collapse flooded the lower Dunmore district, the Peace Corps relief command is moving fifteen thousand people up the Dunmore Corridor, a single road along the southern escarpment. Your Corridor Post at the eastern end is the only place the convoys can unload. Three evacuation columns of four Pathfinder APCs are staged at the western depot.", "lore": "faction.napc"},
    {"heading": "The Oversight Mission", "text": "The Confederation's Oversight Mission sits north of the road and has agreed to the relief on one condition: every column is inspected by a civilian board before it passes. The Assembly refuses to let a foreign board delay a rescue; the Confederation refuses to let a military command decide alone. Both are right about the other. Expect that argument to stop being polite.", "lore": "faction.nec"},
    {"heading": "Orders", "text": "Hold the Post, keep the road open and get all three columns through, with at least three vehicles of each column arriving. Recover the vehicles stranded halfway along the road if you can; the Corps does not leave equipment behind. Doctrine: durable armour, repair at the factory apron, patience."}
  ],
  "map": {"family": "open", "size": 128, "seed": 14},
  "sim_seed": 1401,
  "rules": {"start_credits": 6000, "fog": 1},
  "players": [
    {"slot": 0, "kind": "human", "name": "Corridor Post", "roster": "roster.napc.vanilla", "team": 1, "credits": 6000, "start": {"mode": "hq", "units": [{"def": "unit.napc.guardian_tank", "count": 4, "dx": 5, "dy": 3}, {"def": "unit.napc.javelin_team", "count": 2, "dx": 3, "dy": 6}, {"def": "unit.napc.rifle_squad", "count": 2, "dx": 6, "dy": 6}]}},
    {"slot": 1, "kind": "ai", "name": "Relief Column", "roster": "roster.napc.vanilla", "team": 1, "start_slot": 1, "ai": {"level": 0, "style": 0, "active": false}, "start": {"mode": "none"}},
    {"slot": 2, "kind": "ai", "name": "Oversight Mission", "roster": "roster.nec.vanilla", "team": 2, "start_slot": 2, "ai": {"level": 0, "style": 0, "active": false}, "start": {"mode": "hq"}}
  ],
  "areas": [
    {"id": "a_post", "shape": "circle", "anchor": "start:0", "x": 0, "y": 0, "r": 10},
    {"id": "a_exit", "shape": "circle", "anchor": "start:0", "x": -5, "y": 2, "r": 6},
    {"id": "a_wp1", "shape": "circle", "anchor": "start:0", "x": -46, "y": 2, "r": 5},
    {"id": "a_wp2", "shape": "circle", "anchor": "start:0", "x": -24, "y": 2, "r": 5},
    {"id": "a_depot", "shape": "circle", "anchor": "start:1", "x": 4, "y": 2, "r": 5},
    {"id": "a_strand", "shape": "circle", "anchor": "start:0", "x": -17, "y": -12, "r": 4},
    {"id": "a_chk", "shape": "circle", "anchor": "start:0", "x": -22, "y": -4, "r": 5},
    {"id": "a_ridge1", "shape": "circle", "anchor": "start:0", "x": -30, "y": -26, "r": 5},
    {"id": "a_ridge2", "shape": "circle", "anchor": "start:0", "x": -50, "y": -24, "r": 5},
    {"id": "a_ridge3", "shape": "circle", "anchor": "start:0", "x": -12, "y": -30, "r": 5}
  ],
  "messages": [
    {"id": "intro", "text": "Corridor Post, this is Corps Command. Column Alpha leaves the depot in two minutes. The Oversight Mission has not yet answered our last signal.", "speaker": "Corps Command", "announcer": "match_start_napc"},
    {"id": "launch_a", "text": "Column Alpha is rolling. Four APCs, west to east. Keep the road clear.", "speaker": "Corps Command"},
    {"id": "launch_b", "text": "Column Bravo is rolling. The checkpoint is down, the road is ours. Four APCs, west to east.", "speaker": "Corps Command"},
    {"id": "launch_c", "text": "Column Charlie, the last one, is rolling. Everything we have left on that road is in it.", "speaker": "Corps Command"},
    {"id": "hop", "text": "The column is moving up the next stretch of the road.", "speaker": "Corps Command"},
    {"id": "strand", "text": "Three of our APCs broke down on the ridge track north of the road and the crews walked on. Tow them back to the Post when the road is quiet: the factory apron will repair them.", "speaker": "Corps Command"},
    {"id": "arr_a", "text": "Alpha is through. Fifty-odd families off the road. Good work, Post.", "speaker": "Corps Command"},
    {"id": "arr_b", "text": "Bravo is through. Two columns down, one to go.", "speaker": "Corps Command"},
    {"id": "arr_c", "text": "Charlie is through. That is everyone. Corridor Post, the road is yours.", "speaker": "Corps Command"},
    {"id": "twist", "text": "Post, the Oversight Mission has just declared the corridor closed to unsupervised traffic and is raising a checkpoint at the halfway marker. They are reinforcing it. They will not let Bravo through. We cannot wait for another round of talks.", "speaker": "Corps Command", "announcer": "base_under_attack"},
    {"id": "ov_warn", "text": "Corps column, you will halt at the inspection point. This is the last notice. A civilian board answers for every vehicle on that road.", "speaker": "Oversight Mission"},
    {"id": "chk_down", "text": "The checkpoint is down. Bravo can move. Whatever the Assembly decides about this, the road is open.", "speaker": "Corps Command"},
    {"id": "late", "text": "The evacuation window is closing. If the columns are not through in the next two minutes the flood takes the lower road.", "speaker": "Corps Command", "announcer": "unit_under_attack"},
    {"id": "lose_post", "text": "The Corridor Post has fallen. The road is lost.", "speaker": "Corps Command", "announcer": "defeat"},
    {"id": "lose_col", "text": "The column was destroyed on the road. There is nothing more to bring through.", "speaker": "Corps Command", "announcer": "defeat"},
    {"id": "lose_time", "text": "The window has closed. The lower road is under water.", "speaker": "Corps Command", "announcer": "defeat"},
    {"id": "win", "text": "All three columns are through. The Assembly will call this a rescue and the Confederation will call it a breach. Both of them are going to ask who gave the order at the checkpoint.", "speaker": "Corps Command", "announcer": "victory"},
    {"id": "debrief_win", "text": "DEBRIEF: the relief reached its people. The Oversight Mission filed a protest within the hour; the Assembly's reply was one line long. In the capitals, the argument over who may command a shared relief operation has just become a real one.", "speaker": "Debrief"},
    {"id": "debrief_lose", "text": "DEBRIEF: the corridor was lost. Both commands blame the other for the delay, and the people on the lower road blame both.", "speaker": "Debrief"}
  ],
  "objectives": [
    {"id": "evac", "kind": "primary", "text": "Deliver all three evacuation columns (3 of 4 APCs each) to the Corridor Post"},
    {"id": "post", "kind": "primary", "text": "Hold the Corridor Post"},
    {"id": "checkpoint", "kind": "primary", "text": "Break the Oversight checkpoint at the halfway marker", "initial": "hidden"},
    {"id": "recover", "kind": "secondary", "text": "Recover the three stranded APCs to the Post", "initial": "hidden"},
    {"id": "intact", "kind": "secondary", "text": "Lose no evacuation APC"},
    {"id": "live_a", "kind": "hidden", "text": "Column A on the road", "initial": "hidden"},
    {"id": "done_a", "kind": "hidden", "text": "Column A delivered", "initial": "hidden"},
    {"id": "live_b", "kind": "hidden", "text": "Column B on the road", "initial": "hidden"},
    {"id": "done_b", "kind": "hidden", "text": "Column B delivered", "initial": "hidden"},
    {"id": "live_c", "kind": "hidden", "text": "Column C on the road", "initial": "hidden"},
    {"id": "done_c", "kind": "hidden", "text": "Column C delivered", "initial": "hidden"}
  ],
  "timers": [
    {"id": "hop_t", "seconds": 40, "label": "Column hop", "repeat": true}
  ],
  "triggers": [
    {"id": "t00_start", "when": {"kind": "time", "cmp": ">=", "ticks": 0}, "then": [{"do": "show_message", "message": "intro"}, {"do": "music_state", "state": "calm"}]},
    {"id": "t01_ai_on", "when": {"kind": "time", "cmp": ">=", "seconds": 240}, "then": [{"do": "change_ai", "owner": 2, "active": true}]},
    {"id": "t02_strand", "when": {"kind": "time", "cmp": ">=", "seconds": 270}, "then": [{"do": "spawn_units", "owner": 0, "def": "unit.napc.pathfinder_apc", "count": 3, "area": "a_strand", "order": {"kind": "hold"}}, {"do": "show_message", "message": "strand"}, {"do": "set_objective", "objective": "recover", "state": "active"}]},
    {"id": "t03_recover", "when": {"all": [{"kind": "objective", "objective": "recover", "state": "active"}, {"kind": "count", "owner": 0, "def": "unit.napc.pathfinder_apc", "area": "a_post", "value": 3}]}, "then": [{"do": "set_objective", "objective": "recover", "state": "completed"}]},
    {"id": "t1a0_launch", "when": {"kind": "time", "cmp": ">=", "seconds": 120}, "then": [{"do": "spawn_units", "owner": 1, "def": "unit.napc.pathfinder_apc", "count": 4, "area": "a_depot", "wave": "col_a", "order": {"kind": "move", "area": "a_wp1"}}, {"do": "show_message", "message": "launch_a"}, {"do": "music_state", "state": "tense"}, {"do": "set_objective", "objective": "live_a", "state": "active"}, {"do": "timer_start", "timer": "hop_t"}, {"do": "trigger_enable", "trigger": "t1a1_hop1"}, {"do": "spawn_units", "owner": 2, "def": "unit.nec.leopard_tank", "count": 2, "area": "a_ridge1", "wave": "raid_a", "order": {"kind": "attack_move", "area": "a_wp2"}}, {"do": "spawn_units", "owner": 2, "def": "unit.nec.jager_squad", "count": 1, "area": "a_ridge1", "wave": "raid_a", "order": {"kind": "attack_move", "area": "a_wp2"}}]},
    {"id": "t1a1_hop1", "enabled": false, "when": {"kind": "timer", "timer": "hop_t"}, "then": [{"do": "order_units", "owner": 1, "order": {"kind": "move", "area": "a_wp2"}}, {"do": "show_message", "message": "hop"}, {"do": "timer_start", "timer": "hop_t"}, {"do": "trigger_enable", "trigger": "t1a2_hop2"}, {"do": "trigger_enable", "trigger": "t1a3a_loss"}, {"do": "trigger_enable", "trigger": "t1a4_fail"}]},
    {"id": "t1a2_hop2", "enabled": false, "when": {"kind": "timer", "timer": "hop_t"}, "then": [{"do": "order_units", "owner": 1, "order": {"kind": "move", "area": "a_exit"}}, {"do": "trigger_disable", "trigger": "t1a1_hop1"}]},
    {"id": "t1a3a_loss", "enabled": false, "when": {"all": [{"kind": "objective", "objective": "intact", "state": "active"}, {"kind": "objective", "objective": "live_a", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "cmp": "<", "value": 4}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "area": "a_exit", "value": 3}]}, "then": [{"do": "set_objective", "objective": "intact", "state": "failed"}]},
    {"id": "t1a3b_arrive", "when": {"all": [{"kind": "objective", "objective": "live_a", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "area": "a_exit", "value": 3}]}, "then": [{"do": "set_objective", "objective": "live_a", "state": "completed"}, {"do": "set_objective", "objective": "done_a", "state": "completed"}, {"do": "show_message", "message": "arr_a"}, {"do": "destroy", "owner": 1, "def": "unit.napc.pathfinder_apc"}, {"do": "music_state", "state": "calm"}, {"do": "timer_stop", "timer": "hop_t"}]},
    {"id": "t1a4_fail", "enabled": false, "when": {"all": [{"kind": "objective", "objective": "live_a", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "cmp": "<", "value": 3}]}, "then": [{"do": "show_message", "message": "lose_col"}, {"do": "show_message", "message": "debrief_lose"}, {"do": "set_objective", "objective": "evac", "state": "failed"}, {"do": "lose", "owner": 0}, {"do": "music_state", "state": "defeat"}]},
    {"id": "t1b0_launch", "when": {"all": [{"kind": "objective", "objective": "checkpoint", "state": "completed"}, {"kind": "objective", "objective": "done_a", "state": "completed"}, {"kind": "time", "cmp": ">=", "seconds": 420}]}, "then": [{"do": "spawn_units", "owner": 1, "def": "unit.napc.pathfinder_apc", "count": 4, "area": "a_depot", "wave": "col_b", "order": {"kind": "move", "area": "a_wp1"}}, {"do": "show_message", "message": "launch_b"}, {"do": "music_state", "state": "tense"}, {"do": "set_objective", "objective": "live_b", "state": "active"}, {"do": "timer_start", "timer": "hop_t"}, {"do": "trigger_enable", "trigger": "t1b1_hop1"}, {"do": "spawn_units", "owner": 2, "def": "unit.nec.leopard_tank", "count": 3, "area": "a_ridge2", "wave": "raid_b", "order": {"kind": "attack_move", "area": "a_wp2"}}, {"do": "spawn_units", "owner": 2, "def": "unit.nec.jager_squad", "count": 2, "area": "a_ridge2", "wave": "raid_b", "order": {"kind": "attack_move", "area": "a_wp2"}}, {"do": "spawn_units", "owner": 2, "def": "unit.nec.spike_team", "count": 1, "area": "a_ridge3", "wave": "raid_b", "order": {"kind": "attack_move", "area": "a_exit"}}]},
    {"id": "t1b1_hop1", "enabled": false, "when": {"kind": "timer", "timer": "hop_t"}, "then": [{"do": "order_units", "owner": 1, "order": {"kind": "move", "area": "a_wp2"}}, {"do": "show_message", "message": "hop"}, {"do": "timer_start", "timer": "hop_t"}, {"do": "trigger_enable", "trigger": "t1b2_hop2"}, {"do": "trigger_enable", "trigger": "t1b3a_loss"}, {"do": "trigger_enable", "trigger": "t1b4_fail"}]},
    {"id": "t1b2_hop2", "enabled": false, "when": {"kind": "timer", "timer": "hop_t"}, "then": [{"do": "order_units", "owner": 1, "order": {"kind": "move", "area": "a_exit"}}, {"do": "trigger_disable", "trigger": "t1b1_hop1"}]},
    {"id": "t1b3a_loss", "enabled": false, "when": {"all": [{"kind": "objective", "objective": "intact", "state": "active"}, {"kind": "objective", "objective": "live_b", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "cmp": "<", "value": 4}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "area": "a_exit", "value": 3}]}, "then": [{"do": "set_objective", "objective": "intact", "state": "failed"}]},
    {"id": "t1b3b_arrive", "when": {"all": [{"kind": "objective", "objective": "live_b", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "area": "a_exit", "value": 3}]}, "then": [{"do": "set_objective", "objective": "live_b", "state": "completed"}, {"do": "set_objective", "objective": "done_b", "state": "completed"}, {"do": "show_message", "message": "arr_b"}, {"do": "destroy", "owner": 1, "def": "unit.napc.pathfinder_apc"}, {"do": "music_state", "state": "calm"}, {"do": "timer_stop", "timer": "hop_t"}]},
    {"id": "t1b4_fail", "enabled": false, "when": {"all": [{"kind": "objective", "objective": "live_b", "state": "active"}, {"kind": "count", "owner": 1, "def": "unit.napc.pathfinder_apc", "cmp": "<", "value": 3}]}, "then": [{"do": "show_message", "message": "lose_col"}, {"do": "show_message", "message": "debrief_lose"}, {"do": "set_objective", "objective": "evac", "state": "failed"}, {"do": "lose", "owner": 0}, {"do": "music_state", "state": "defeat"}]},
