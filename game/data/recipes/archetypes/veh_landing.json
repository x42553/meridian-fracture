      "do": [
        ["box", ["hw-0.55", "(dy+0.02)+0.75*0.55", "hl-0.55"], [0.85, 0.03, 0.09], 0.0],
        ["box", ["hw-0.55", "(dy+0.02)+0.75*0.55", "hl-0.55"], [0.09, 0.03, 0.85], 0.0]
      ]
    },
    ["brush", "dark"],
    ["cyl", ["hw-0.55", "(dy+0.02)+0.75*0.55", "hl-0.55"], ["hw-0.55", "(dy+0.02)+0.75*0.55+0.06", "hl-0.55"], 0.08, 6, 0.0],
    ["brush", "dark"],
    ["cyl", ["-(hw-0.55)", "dy+0.02", "hl-0.55"], ["-(hw-0.55)", "(dy+0.02)+0.75", "hl-0.55"], 0.5, 14, 0.01, false],
    ["brush", "metal", "metal"],
    {
      "part": {"kind": "rotor", "pivot": ["-(hw-0.55)", "(dy+0.02)+0.75*0.55", "hl-0.55"]},
      "do": [
        ["box", ["-(hw-0.55)", "(dy+0.02)+0.75*0.55", "hl-0.55"], [0.85, 0.03, 0.09], 0.0],
        ["box", ["-(hw-0.55)", "(dy+0.02)+0.75*0.55", "hl-0.55"], [0.09, 0.03, 0.85], 0.0]
      ]
    },
    ["brush", "dark"],
    ["cyl", ["-(hw-0.55)", "(dy+0.02)+0.75*0.55", "hl-0.55"], ["-(hw-0.55)", "(dy+0.02)+0.75*0.55+0.06", "hl-0.55"], 0.08, 6, 0.0],
    {
      "part": {"kind": "deploy", "pivot": [0, "dy", "-hl+0.06"], "param": 0.143},
      "do": [
        ["brush", "sec"],
        ["box", [0, "dy+0.55", "-hl+0.06"], ["ld_wid-0.5", 1.1, 0.12], 0.03],
        ["brush", "acc"],
        ["box", [0, "dy+1.0", "-hl+0.0"], ["ld_wid-0.5", 0.1, 0.05], 0.0]
      ]
    },
    {
      "switch": "cargo",
      "cases": {"crate": [{"call": "container", "args": {"center": [0, "dy+0.45", 0.3], "size": [1.4, 0.8, 1.8], "col": "sec"}}]}
    },
    {
      "switch": "roof",
      "cases": {"mast": [{"call": "sensor_mast", "args": {"base": ["hw-0.55", "dy+0.9", "-(hl-1.5)"], "h": 1.3, "folded": 0.5}}]},
      "default": [
        {
          "call": "whip",
          "args": {"base": ["hw-0.3", "dy+0.9", "-(hl-1.6)"], "tip": ["hw-0.32", "dy+1.9", "-(hl-1.65)"], "r": 0.011, "col": "metal"}
        }
      ]
    },
    {
      "mirror_x": [
        {
          "switch": "skirt",
          "cases": {
            "modules": [
              {
                "for": "j",
                "n": 5,
                "do": [
                  ["brush", "j % 2 == 0 ? 'base' : 'sec'"],
                  ["box", ["hw+0.02", 0.72, "-(hl)+0.25+(ld_len-1.0)/5*(j+0.5)"], [0.09, 0.3, "(ld_len-1.0)/5-0.07"], 0.012]
                ]
              },
              ["brush", "dark"],
              ["box", ["hw+0.02", "0.72+0.3*0.5+0.02", 0], [0.1, 0.04, "5*(ld_len-1.0)/5-0.05"], 0.0]
            ],
            "none": []
          },
          "default": [{"call": "skirt", "args": {"kind": "skirt", "x": "hw+0.02", "y": 0.72, "len": "2*(hl)", "h": 0.3}}]
        }
      ]
    },
    ["brush", "metal", "metal"],
    ["pocket", [0.55, "dy+0.03", "-hl+1.9"], [0.8, 0.03, 1.2], [[0.08, 0.1, 0.84, 0.25], [0.08, 0.5, 0.84, 0.25]], 0.02],
    ["brush", "acc"],
    ["box", [0, "dy+0.1", "-hl+0.6"], ["ld_wid-0.9", 0.05, 0.1], 0.0],
    ["brush", "metal", "metal"],
    {
      "mirror_x": [
        {
          "for": "k",
          "n": 3,
          "do": [
            [
              "cyl",
              ["hw-0.34", "dy+0.06", "lerp(-hl+1.5,hl-1.7,k/2)"],
              ["hw-0.34", "dy+0.2", "lerp(-hl+1.5,hl-1.7,k/2)"],
              0.05,
              6,
              0.0
            ]
          ]
        }
