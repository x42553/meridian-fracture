    {"call": "team_panel", "args": {"center": [0, "dy+0.11", 0.35], "size": [1.3, 0.02, 1.1]}},
    {"call": "team_panel", "args": {"center": [0, "dy+0.11", "hl-0.65"], "size": [0.6, 0.02, 0.4]}},
