    ["brush", "light", "emissive"],
    {"part": {"kind": "blink"}, "do": [["box", ["hw-0.55", "dy+1.02", "-(hl-1.4)"], [0.1, 0.06, 0.1], 0.0]]},
    ["socket", "door_exit", [0, "dy", "-hl-0.9"], [0, 0, -1]],
    ["socket", "exhaust0", ["hw-0.55", "dy+0.5", "hl-0.55"], [0, 1, 0]],
    ["socket", "top", [0, "dy+1.6", 0], [0, 1, 0]]
  ]
}
