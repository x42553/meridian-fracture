    {"for": "s", "n": 2, "do": [["box", ["(s*2-1)*(hw-0.1)", "dy+0.3", 0.1], [0.05, 0.05, "ld_len-1.5"], 0.0]]},
    {
      "for": "i",
      "n": 5,
      "do": [
