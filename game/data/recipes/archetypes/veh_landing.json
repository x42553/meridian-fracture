    ["brush", "acc"],
    {"for": "i", "n": 4, "do": [["box", ["-0.75+0.5*i", "dy+0.1", 0.15], [0.05, 0.02, "ld_len-1.3"], 0.0]]},
    ["brush", "sec"],
    [
      "extrude",
      [["hl-1.9", "dy"], ["hl-1.9", "dy+0.9"], ["hl-1.1", "dy+0.9"], ["hl-0.75", "dy+0.45"], ["hl-0.75", "dy"]],
      "hw-0.95",
      "hw-0.15",
      0.04
    ],
    ["brush", "glass", "glass"],
    {"push": {"pos": ["hw-0.55", "dy+0.7", "-(hl-0.92)"], "euler": [-40, 0, 0]}, "do": [["box", [0, 0, 0], [0.7, 0.03, 0.4], 0.0]]},
    ["box", ["hw-0.94", "dy+0.62", "-(hl-1.4)"], [0.03, 0.3, 0.9], 0.0],
    ["brush", "acc"],
    ["box", ["hw-0.55", "dy+0.93", "-(hl-1.5)"], [0.5, 0.05, 0.1], 0.0],
