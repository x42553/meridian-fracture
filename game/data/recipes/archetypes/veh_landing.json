{
  "schema": "meridian.archetype/1",
  "id": "veh_landing",
  "size_class": "light",
  "meta": {
    "motion": "amphibious",
    "wreck": {"turret_yaw_deg": 0, "tilt_deg": [2, 0, -5]},
    "doc": "Landing transport (service.landing_transport): flat-deck air-cushion craft, bow ramp (DEPLOY), rear fans (ROTOR), cargo none|crate. Sockets door_exit, exhaust0, top."
  },
  "defaults": {"ld_len": 5.0, "ld_wid": 2.8, "skirt": "none", "roof": "cupola", "cargo": "empty"},
