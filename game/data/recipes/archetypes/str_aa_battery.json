{
  "schema": "meridian.archetype/1",
  "id": "str_aa_battery",
  "size_class": "structure",
  "meta": {"motion": "static", "death": {"kind": "structure", "ticks": 7}, "doc": "AA battery (2x2): bunker with a turret; `weapon` = missile (2x2 rack, elevated) | flak (twin flak mount); spinner radar. muzzle0_0 on the turret."},
  "defaults": {"weapon": "missile"},
  "slots": {"roof": [], "front": [], "extra": []},
  "derive": {
    "pw": "fw*3-0.5",
    "ph": "fh*3-0.5",
    "hw": "pw*0.5",
    "hh": "ph*0.5",
    "ap": "fw*fh>1 ? 1.0 : 0.3",
    "fz": "hh-ap",
    "bk": "-hh+0.25",
    "bd": "fz-bk",
    "bz": "(fz+bk)*0.5",
    "bw": "pw-0.5",
    "k": "clamp(min(pw,ph)/5.5,0.5,1.25)",
    "hcap": "(max(fw,fh)>=4 ? 12.5 : (max(fw,fh)>=3 ? 10 : 7))-0.35",
    "bh": "1.8*clamp(k,0.7,1.2)",
    "cz": "bz-bd*0.05",
    "ty": "bh+0.4",
    "ry": "bh+0.09"
  },
  "ops": [
    ["bevel", 0.04],
    {"call": "foundation", "args": {"fw": "fw", "fh": "fh", "depth": 1.2, "col": "concrete", "edge": "dark", "chevron": "fw*fh>1 ? 1 : 0", "acc": "acc"}},
    {"call": "wall_block", "args": {"center": [0, "bh*0.5", "bz"], "size": ["bw*0.9", "bh", "bd*0.88"], "col": "base", "sec": "base", "dado": 0.0, "ribs": 1, "rib": "sec", "cap": "sec", "coping": 0}},
    ["brush", "dark"],
    ["ao", 0.75],
    ["box", [0, 0.3, "bz"], ["bw*0.9+0.1", 0.3, "bd*0.88+0.1"], 0.02],
    ["ao", 1.0],
    ["brush", "acc"],
    ["box", [0, "bh-0.3", "bz"], ["bw*0.9+0.1", 0.08, "bd*0.88+0.1"], 0.02],
    ["brush", "mix(sec,dark,0.55)"],
    ["box", [0, "(bh)+0.04", "bz"], ["(bw*0.9)+0.06", 0.08, "(bd*0.88)+0.06"], 0.01],
    ["brush", "sec"],
    ["box", [0, "(bh)+0.08+0.08", "(bz)+(bd*0.88)*0.5-0.06"], ["(bw*0.9)+0.16", 0.16, 0.12], 0.02],
    ["box", [0, "(bh)+0.08+0.08", "(bz)-(bd*0.88)*0.5+0.06"], ["(bw*0.9)+0.16", 0.16, 0.12], 0.02],
    ["box", ["0+(bw*0.9)*0.5-0.06", "(bh)+0.08+0.08", "bz"], [0.12, 0.16, "(bd*0.88)-0.24"], 0.02],
    ["box", ["0-(bw*0.9)*0.5+0.06", "(bh)+0.08+0.08", "bz"], [0.12, 0.16, "(bd*0.88)-0.24"], 0.02],
    {"call": "turret_base", "args": {"center": [0, "ry", "cz"], "r": "min(1.0*clamp(k,0.6,1.1),bd*0.34)", "h": 0.4, "col": "base", "ring": "acc"}},
    {
      "switch": "weapon",
      "cases": {
        "missile": [
          {
            "part": {"kind": "turret", "pivot": [0, "ty", "cz"]},
            "do": [
              {"call": "turret_ngon", "args": {"pivot": [0, "ty", "cz"], "n": 6, "rot": 0, "hw": "0.7*clamp(k,0.7,1.1)", "hl": "0.6*clamp(k,0.7,1.1)", "h": 0.4, "top": 0.8, "shift": 0, "y0": "ty+0.05"}},
              {"call": "missile_rack", "args": {"center": [0, "ty+0.6", "cz-0.1"], "cols": 2, "rows": 2, "elev": 40, "mount": 0}}
            ]
          },
          ["socket", "muzzle0_0", [0, "ty+1.0", "cz-1.0"], [0, 0.6, -1]]
        ],
        "flak": [
          {
            "part": {"kind": "turret", "pivot": [0, "ty", "cz"]},
            "do": [
              {"call": "turret_ngon", "args": {"pivot": [0, "ty", "cz"], "n": 6, "rot": 0, "hw": "0.7*clamp(k,0.7,1.1)", "hl": "0.6*clamp(k,0.7,1.1)", "h": 0.3, "top": 0.8, "shift": 0, "y0": "ty+0.05"}},
              {"call": "flak_twin", "args": {"center": [0, "ty+0.3", "cz-0.1"]}}
            ]
          },
          ["socket", "muzzle0_0", [0.2, "ty+0.6", "cz-1.5"], [0, 0, -1]]
        ]
      }
    },
    {"call": "radar_dish", "args": {"center": ["bw*0.3", "ry", "bz+bd*0.25"], "r": "0.45*clamp(k,0.7,1.1)", "spin": 1}},
    {"call": "roof_plate", "args": {"center": ["-bw*0.28", "ry+0.05", "bz+bd*0.24"], "size": ["clamp(bw*0.24,0.9,1.3)", 0.03, "clamp(bd*0.16,0.6,0.9)"]}},
    ["brush", "light", "emissive"],
    ["box", [0, "bh*0.45", "bz+bd*0.44+0.02"], ["bw*0.4", 0.05, 0.03]],
    {"call": "window_strip", "args": {"center": ["bw*0.45+0.03", "bh*0.55", "bz"], "n": 1, "size": [0.8, 0.5, 0.05], "dir": 90, "col": "mix(light,glass,0.5)"}},
    {
      "push": {"pos": ["-bw*0.45", 0.16, "bk+0.5"], "euler": [0, 25, 0]},
      "do": [
        ["brush", "dark"],
        ["box", [0, 0.16, 0], [0.5, 0.32, 0.4], 0.03],
        ["brush", "acc"],
        ["box", [0, 0.335, 0], [0.52, 0.03, 0.42], 0],
        ["brush", "mix(base,dark,0.3)"],
        ["box", [0.42, 0.11, 0.06], [0.34, 0.22, 0.3], 0.03],
        ["box", [0.1, 0.44, 0.02], [0.36, 0.22, 0.3], 0.03]
      ]
    },
    ["socket", "door_exit", ["door_cx", 0.16, "door_cz"], [0, 0, 1]],
    ["socket", "weld0", [0.7, "bh+0.3", 0.3], [0, 1, 0]],
    ["socket", "weld1", [-0.7, "bh+0.3", -0.3], [0, 1, 0]],
    ["socket", "weld2", [0, "bh+0.3", 0.15], [0, 1, 0]],
    ["socket", "top", [0, "ty+1.4", "cz"], [0, 1, 0]],
    {"slot": "roof"},
    {"slot": "front"},
    {"slot": "extra"},
    ["meta", "footprint", ["fw", "fh"]]
  ]
}
