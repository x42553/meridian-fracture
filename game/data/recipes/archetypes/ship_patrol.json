{
  "schema": "meridian.archetype/1",
  "id": "ship_patrol",
  "size_class": "ship",
  "meta": {
    "motion": "naval",
    "death": {"kind": "sink", "ticks": 60},
    "doc": "Patrol boat (ship_patrol): bow sharp|blunt|round, cabin bubble|closed, gun mg|auto. Spinning radar bar; deck gun = mount 0."
  },
  "defaults": {"sp_len": 5.0, "sp_beam": 1.95, "bow": "sharp", "cabin": "bubble", "gun": "mg", "roof": "cupola", "deck": "none"},
  "derive": {"hl": "sp_len*0.5", "fb": "0.62"},
  "ops": [
    ["bevel", 0.03],
    {
      "call": "hull_ship",
      "args": {
        "len": "sp_len",
        "beam": "sp_beam",
        "draft": 0.32,
        "bow": "bow",
        "freeboard": "fb",
        "col": "base",
        "low": "dark",
        "stripe": "acc",
        "deck": "dark"
      }
    },
    ["brush", "sec"],
    [
      "extrude",
      [
        ["-hl*0.05-0.5", "fb+0.02"],
        ["-hl*0.05-0.5", "fb+0.72"],
        ["-hl*0.05+0.3", "fb+0.72"],
        ["-hl*0.05+0.7", "fb+0.34"],
        ["-hl*0.05+0.7", "fb+0.02"]
      ],
      "-sp_beam*0.5+0.32",
      "sp_beam*0.5-0.32",
      0.05
    ],
    ["brush", "glass", "glass"],
    {
      "switch": "cabin",
      "cases": {"closed": [["box", [0, "fb+0.5", "hl*0.05+0.2"], ["sp_beam-0.85", 0.22, 0.03], 0.0]]},
      "default": [
        {
          "push": {"pos": [0, "fb+0.55", "hl*0.05-0.38"], "euler": [-45, 0, 0]},
          "do": [["box", [0, 0, 0], ["sp_beam-0.75", 0.03, 0.55], 0.0]]
        },
        {"for": "s", "n": 2, "do": [["box", ["(s*2-1)*(sp_beam*0.5-0.315)", "fb+0.45", "hl*0.05-0.1"], [0.03, 0.3, 0.7], 0.0]]}
      ]
    },
    ["brush", "acc"],
    ["box", [0, "fb+0.745", "hl*0.05-0.1"], ["sp_beam-0.7", 0.04, 0.08], 0.0],
    {"call": "team_panel", "args": {"center": [0, "fb+0.745", "hl*0.05-0.3"], "size": [0.5, 0.02, 0.3]}},
    ["brush", "metal", "metal"],
    ["cyl", [0, "fb+0.72", "hl*0.05-0.1"], [0, "fb+1.5", "hl*0.05-0.1"], 0.035, 6, 0.0],
    {
      "part": {"kind": "radar", "pivot": [0, "fb+1.55", "hl*0.05-0.1"], "extra": 1.0},
      "do": [
        ["brush", "sec"],
        ["box", [0, "fb+1.55", "hl*0.05-0.1"], ["sp_beam*0.5", 0.05, 0.11], 0.01],
        ["brush", "acc"],
        ["box", [0.3, "fb+1.59", "hl*0.05-0.1"], [0.14, 0.04, 0.09], 0.0]
      ]
    },
    {
      "call": "ship_turret",
      "args": {
        "pos": [0, "fb", "-hl*0.5"],
        "barrels": "gun == 'auto' ? 1 : 1",
        "mount": 0,
        "r": "gun == 'auto' ? 0.36 : 0.28",
        "len": "gun == 'auto' ? 1.1 : 0.85",
        "br": "gun == 'auto' ? 0.07 : 0.045",
        "col": "base"
      }
    },
    ["brush", "acc"],
    {
      "for": "s",
      "n": 2,
      "do": [["cyl", ["(s*2-1)*0.42", "fb+0.2", "hl*0.5"], ["(s*2-1)*0.42", "fb+0.2", "hl*0.5+0.8"], 0.16, 10, 0.0]]
    },
    ["brush", "dark"],
    ["box", [0, "fb+0.05", "hl-0.35"], ["sp_beam*0.6", 0.05, 0.6], 0.0],
    {"call": "team_panel", "args": {"center": [0, "fb+0.08", "hl-0.35"], "size": [0.8, 0.02, 0.4]}},
    {
      "call": "light_pair",
      "args": {"center": [0, "fb+0.3", "hl+0.02"], "spacing": 1.2, "size": [0.12, 0.08, 0.04], "col": "#ff140a"}
    },
    {
      "switch": "deck",
      "cases": {"container": [{"call": "container", "args": {"center": [0, "fb+0.3", "hl*0.5+0.4"], "size": [0.9, 0.5, 0.9], "col": "sec"}}]}
    },
    [
      "socket",
      "muzzle0_0",
      [
        0,
        "fb+0.36*(gun == 'auto' ? 0.36 : 0.28)/0.42",
        "-hl*0.5-(gun == 'auto' ? 0.36 : 0.28)*0.6-(gun == 'auto' ? 1.1 : 0.85)-0.05"
      ],
      [0, 0, -1],
      "barrel"
    ],
    {
      "mirror_x": [
        ["tier", 2],
        ["brush", "metal", "metal"],
        {
          "for": "k",
          "n": 8,
          "do": [
            [
              "cyl",
              ["sp_beam*0.5-0.13", "fb", "lerp(-hl*0.35,hl-0.3,k/7)"],
              ["sp_beam*0.5-0.13", "(fb)+0.28", "lerp(-hl*0.35,hl-0.3,k/7)"],
              0.018,
              5,
              0.0
            ]
          ]
        },
        ["box", ["sp_beam*0.5-0.13", "(fb)+0.28", "((-hl*0.35)+(hl-0.3))*0.5"], [0.03, 0.03, "(hl-0.3)-(-hl*0.35)"], 0.0],
        ["box", ["sp_beam*0.5-0.13", "(fb)+0.28*0.5", "((-hl*0.35)+(hl-0.3))*0.5"], [0.02, 0.02, "(hl-0.3)-(-hl*0.35)"], 0.0],
        ["tier", 0]
      ]
    },
    ["brush", "dark", "metal"],
    ["cyl", [0, "fb+0.6", "hl*0.05+0.85"], [0, "(fb+0.6)+0.5", "hl*0.05+0.85"], 0.16, 10, 0.02],
    ["brush", "acc"],
    ["cyl", [0, "(fb+0.6)+0.5-0.12", "hl*0.05+0.85"], [0, "(fb+0.6)+0.5-0.04", "hl*0.05+0.85"], 0.16640000000000002, 10, 0.0],
    ["brush", "metal", "metal"],
    ["cyl", [0, "(fb+0.6)+0.5", "hl*0.05+0.85"], [0, "(fb+0.6)+0.5+0.02", "hl*0.05+0.85"], 0.128, 10, 0.0],
    ["brush", "acc"],
    ["box", [0, "(fb)+0.16", "hl-0.9"], [0.46, 0.2, 1.05], 0.06],
    ["tbox", [0, "(fb)+0.16", "(hl-0.9)-1.05*0.5-0.12"], [0.44, 0.1], [0.14, 0.26], 0.2, [0, 0], 0.04],
    ["brush", "dark"],
    ["box", [0, "(fb)+0.28", "hl-0.9"], [0.34, 0.03, 0.8400000000000001], 0.0],
    ["brush", "acc"],
    ["cyl", ["-sp_beam*0.5+0.35", "fb+0.05", "-hl*0.25"], ["-sp_beam*0.5+0.35", "fb+0.05", "-hl*0.25+0.4"], 0.06, 6, 0.0],
    ["brush", "metal", "metal"],
    ["cyl", [0, "fb+0.02", "-hl+0.55"], [0, "fb+0.12", "-hl+0.55"], 0.1, 8, 0.0],
    ["brush", "light", "emissive"],
    ["box", [0, "fb+0.79", "hl*0.05-0.1"], [0.08, 0.06, 0.08], 0.0],
    ["socket", "muzzle1_0", [0, "fb+0.3", "-hl*0.5-0.8"], [0, 0, -1]],
    ["socket", "top", [0, 3.0, 0], [0, 1, 0]],
    ["socket", "exhaust0", [0, "fb+0.5", "hl*0.3"], [0, 1, 0]]
  ]
}
